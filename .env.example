# Copie este arquivo para .env.local e ajuste os valores.
# Formato: postgresql://USUARIO:SENHA@SERVIDOR:PORTA/NOME_DO_BANCO
# Se a senha tiver caracteres especiais (@ : / # ?), codifique-os (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres:SUA_SENHA@localhost:5432/soundprofile

# ----- Login com Google -----
# Console do Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web).
# URI de redirecionamento autorizada: <APP_URL>/api/auth/google/callback
# O site usa só o GOOGLE_CLIENT_ID; o segredo é lido pela API (Spring), que troca o código por dados da conta.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
# Endereço público do site, sem barra no fim. Local: http://localhost:3000
#APP_URL=http://localhost:3000
